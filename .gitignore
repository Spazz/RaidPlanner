# Whitelist: everything is ignored unless listed below. Globs cover the folders that grow (js/guild, worker, migrations, tests, tools)
# and every suite under tests/, so a new guild file or suite needs no line here; only a new root file or a new Planner script does.
*
!.gitignore
!index.html
# Static site pages (same header and footer as index.html; they load js/util.js, js/changelog.js, js/site-pages.js), served as-is
!faq.html
!whats-new.html
# The page's stylesheet and the app scripts it loads in order (plain classic scripts, no build step); split-tests.js checks every one is listed
!app.css
!og-image.png
!js/
!js/util.js
!js/rules.js
!js/changelog.js
!js/state.js
!js/import.js
!js/storage.js
!js/livesync.js
!js/plansync.js
!js/optimizer.js
!js/analysis.js
!js/changes.js
!js/render.js
!js/modals.js
!js/app.js
!js/site-pages.js
# Rules data files (plain scripts that assign RulesData.*, loaded before js/rules.js): written once by tools/generate-rules-data.js, then edited by hand
!js/rules/
!js/rules/*.js
# Guild shell scripts (the list and loader are js/guild/manifest.js and js/guild/load.js)
!js/guild/
!js/guild/*.js
# Self-hosted spec/class/role/buff/debuff icons (one <slug>.jpg each, fetched once from the Wowhead CDN); icons-tests.js checks every slug the rule tables name is here
!icons/
!icons/*.jpg
!icons/raids/
!icons/raids/*.webp
# Vercel config (/<version>/<id> rewrite to index.html) and the short-share-link function
!vercel.json
!api/
!api/share.js
# Test suites live in tests/planner, tests/guild and tests/site (covered by !tests/** below; `npm test` runs them under Node); scenarios.js stays at the root: it is the ?dev roster picker data
!scenarios.js
!README.md
!.vercelignore
# Test runner, loader, fakes, fixtures and golden snapshots (everything under tests/), the dev tools (tools/*.js, plus the OG image script) and CI (npm test; GitHub Actions runs it)
!package.json
!tests/
!tests/**
!tools/
!tools/*.js
!tools/make-og-image.py
!.github/
!.github/workflows/
!.github/workflows/test.yml
# DPS reference data cited by the optimizer comments
!gruul_dps_data.txt
# Guild tracker (Cloudflare Worker + D1, local first): config, Worker (any depth), migrations, page styles
!wrangler.jsonc
!.assetsignore
!_headers
!.env.example
!worker/
!worker/**/
!worker/**/*.js
!worker/package.json
!migrations/
!migrations/*.sql
!guild.css

# Never trackable, even where the globs above reach (tests/**, worker/**): secrets, Wrangler state, installed packages
.env
.env.*
!.env.example
.dev.vars*
.wrangler/
node_modules/
