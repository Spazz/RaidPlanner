# Whitelist: everything is ignored unless listed below (new tracked files need a ! line)
*
!.gitignore
!index.html
# The page's stylesheet and the app scripts it loads in order (plain classic scripts, no build step); split-tests.js checks every one is listed
!app.css
!og-image.png
!js/
!js/rules.js
!js/changelog.js
!js/state.js
!js/import.js
!js/storage.js
!js/livesync.js
!js/optimizer.js
!js/analysis.js
!js/changes.js
!js/render.js
!js/modals.js
!js/app.js
# Self-hosted spec/class/role/buff/debuff icons (one <slug>.jpg each, fetched once from the Wowhead CDN); icons-tests.js checks every slug the rule tables name is here
!icons/
!icons/*.jpg
# Vercel config (/<version>/<id> rewrite to index.html) and the short-share-link function
!vercel.json
!api/
!api/share.js
# Test suites are tracked and served as static files; `npm test` (tests/run-all.js) runs them under Node; scenarios.js is also the ?dev roster picker data
!tests.js
!loader-tests.js
!split-tests.js
!scenarios.js
!scenario-tests.js
!version-tests.js
!campfire-tests.js
!classic-tests.js
!features-tests.js
!raidsize-tests.js
!forever-tests.js
!classic-forever-scenarios.js
!assignments-tests.js
!custom-assignments-tests.js
!idealcomp-tests.js
!rosters-tests.js
!prep-tests.js
!insights-tests.js
!control-tests.js
!input-tests.js
!data-tests.js
!import-tests.js
!drums-tests.js
!buffdata-tests.js
!buffparity-tests.js
!plan-tests.js
!commit-tests.js
!nav-tests.js
!share-tests.js
!headers-tests.js
!csp-tests.js
!livesync-tests.js
!security-tests.js
!state-persistence-tests.js
!plan-state-tests.js
!a11y-tests.js
!icons-tests.js
!touch-tests.js
!mobile-tests.js
!ux-tests.js
!shouts-tests.js
!shortcuts-tests.js
!head-tests.js
!deploy-tests.js
!shards-tests.js
!perf-tests.js
!README.md
!changelog-tests.js
!changes-tests.js
!.vercelignore
# Test runner, loader and CI (npm test; GitHub Actions runs it)
!package.json
!tests/
!tests/load-app.js
!tests/run-all.js
!tests/shards.js
!.github/
!.github/workflows/
!.github/workflows/test.yml
# DPS reference data cited by the optimizer comments
!gruul_dps_data.txt
