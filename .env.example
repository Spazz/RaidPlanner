# Names only. Copy to .env (never committed, never served) and fill in. Do not put real values in this file.
# Discord application (OAuth2: scopes identify + guilds; the redirect URI below must be registered with it)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Comma-separated Discord user ids allowed to create a guild
GUILD_CREATOR_ALLOWLIST=
# Warcraft Logs client credentials (Phase 3)
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Battle.net API client (Phase 5; create it at develop.battle.net). The redirect URI below must be registered with it, e.g. http://localhost:8787/auth/bnet/callback
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_REDIRECT_URI=
