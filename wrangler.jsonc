{
  "name": "raidsmith",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/guild", "/guild/", "/api/guild", "/api/guild/*", "/api/share", "/api/share/*", "/tbc/*", "/classic/*", "/forever/*", "/api/roadmap/*", "/api/me", "/api/guest", "/api/public/*", "/api/dev/*", "/api/apply/*", "/api/join", "/api/join/*", "/api/v1/*", "/auth/*", "/cal/*"]
  },
  // Two triggers, dispatched by worker/scheduler.js. Daily at 04:17 UTC: the 30-day rule for Battle.net data (worker/bnet-purge.js). Every 15 minutes: the
  // Raid-Helper refresh of upcoming raids and the Discord channel posts and reminders. The dev tool starts Wrangler with --test-scheduled, so locally:
  //   curl "http://127.0.0.1:8787/__scheduled?cron=17+4+*+*+*"       (daily)
  //   curl "http://127.0.0.1:8787/__scheduled?cron=*/15+*+*+*+*"     (every 15 minutes)
  "triggers": { "crons": ["17 4 * * *", "*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raidsmith",
      "database_id": "64d25379-899d-4709-a1e1-e85d2a1c6d52",
      // Local dev (8787) keeps its D1 file: wrangler keys local state on preview_database_id first.
      "preview_database_id": "local-raidsmith",
      "migrations_dir": "migrations"
    }
  ]
}
