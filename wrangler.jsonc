{
  "name": "raidsmith",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/guild", "/guild/", "/api/guild", "/api/guild/*", "/api/roadmap/*", "/api/me", "/api/guest", "/api/public/*", "/auth/*", "/cal/*"]
  },
  // Daily at 04:17 UTC: the 30-day rule for Battle.net data (worker/bnet-purge.js). The dev tool starts Wrangler with --test-scheduled, so locally:
  //   curl "http://localhost:8787/__scheduled?cron=17+4+*+*+*"
  "triggers": { "crons": ["17 4 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raidsmith",
      "database_id": "local-raidsmith",
      "migrations_dir": "migrations"
    }
  ]
}
