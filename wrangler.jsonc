{
  "name": "raidsmith",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/guild", "/guild/", "/api/guild", "/api/guild/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raidsmith",
      "database_id": "local-raidsmith",
      "migrations_dir": "migrations"
    }
  ]
}
