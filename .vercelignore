# Files Vercel does not upload: tests (everything under /tests/), CI and docs are not part of the running site.
# Everything the page loads must stay out of this list; deploy-tests.js checks that.
# (scenarios.js is kept: the ?dev roster picker fetches it.)
/tests/
/.github/
/gruul_dps_data.txt
/README.md
/CHANGELOG.md
/tools/
# Guild tracker files that only the Cloudflare Worker deployment uses
/worker/
/migrations/
/wrangler.jsonc
/_headers
/.assetsignore
/.env.example
# Local secrets and Wrangler state never ship
/.env*
/.dev.vars*
/.wrangler/
